---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Chronicle of a Dungeons & Dragons: Out of the Abyss campaign.' } = Astro.props;

// Preview builds on the fork are served from a project subpath
// (nabil-boag.github.io/robkennedy1.github.io), so internal links must be
// prefixed with the configured base. import.meta.env.BASE_URL is '/' on the
// real site and '/robkennedy1.github.io/' on the fork preview.
const base = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? base : base + href.slice(1));

const nav = [
  { href: '/', label: 'Story So Far' },
  { href: '/sessions', label: 'Sessions' },
  { href: '/audio-recaps', label: 'Audio Recaps' },
  { href: '/characters', label: 'Heroes' },
  { href: '/npcs', label: 'NPCs' },
  { href: '/quests', label: 'Quests & Lore' },
  { href: '/locations', label: 'Locations' },
];

// normalise current path for active-link highlighting (strip the base first,
// since Astro.url.pathname includes it on the subpath preview)
const basePath = base.replace(/\/$/, '');
const rawPath = Astro.url.pathname;
const stripped = basePath && rawPath.startsWith(basePath) ? rawPath.slice(basePath.length) : rawPath;
const path = stripped.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <title>{title} · Out of the Abyss</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={withBase('/')}>Out of the <b>Abyss</b></a>
        <nav class="nav" aria-label="Primary">
          {nav.map((item) => (
            <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>A D&amp;D campaign chronicle · Out of the Abyss</span>
        <span>Built with Astro</span>
      </div>
    </footer>
  </body>
</html>
