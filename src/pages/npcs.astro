---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CharacterCard from '../components/CharacterCard.astro';

const all = await getCollection('characters');
const npcs = all.filter((c) => c.data.kind === 'npc').sort((a, b) => a.data.order - b.data.order);
const villains = all.filter((c) => c.data.kind === 'villain').sort((a, b) => a.data.order - b.data.order);
---
<Layout title="NPCs">
  <p class="eyebrow">Friends, Strangers &amp; Foes</p>
  <h1 class="page-title">People of the Abyss</h1>
  <p class="lead">The notable figures the party has met so far — only what the heroes themselves have learned.</p>

  <section>
    <h2>Fellow Prisoners &amp; Allies</h2>
    <div class="grid cols-3" style="margin-top:20px">
      {npcs.map((entry) => <CharacterCard entry={entry} />)}
    </div>
  </section>

  <section>
    <h2>The Drow of Velkynvelve</h2>
    <div class="grid cols-3" style="margin-top:20px">
      {villains.map((entry) => <CharacterCard entry={entry} />)}
    </div>
  </section>
</Layout>
