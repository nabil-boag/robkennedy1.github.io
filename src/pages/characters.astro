---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CharacterCard from '../components/CharacterCard.astro';

const pcs = (await getCollection('characters', ({ data }) => data.kind === 'pc'))
  .sort((a, b) => a.data.order - b.data.order);
---
<Layout title="Heroes">
  <p class="eyebrow">The Party</p>
  <h1 class="page-title">Heroes</h1>
  <p class="lead">The captives whose escape from the Underdark this chronicle follows.</p>

  <div class="grid cols-3" style="margin-top:32px">
    {pcs.map((entry) => <CharacterCard entry={entry} />)}
  </div>
</Layout>
