---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const all = (await getCollection('locations')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  all.map(async (entry) => ({ entry, Content: (await entry.render()).Content }))
);
const visited = rendered.filter((r) => r.entry.data.status === 'visited');
const mentioned = rendered.filter((r) => r.entry.data.status === 'mentioned');
---
<Layout title="Locations">
  <p class="eyebrow">The Map</p>
  <h1 class="page-title">Locations</h1>
  <p class="lead">Places the party has been — and places they have only heard whispered of.</p>

  <section>
    <h2>Visited</h2>
    <div class="grid cols-2" style="margin-top:20px">
      {visited.map(({ entry, Content }) => (
        <article class="card">
          {entry.data.image && <img class="thumb" src={entry.data.image} alt={entry.data.name} loading="lazy" />}
          <div class="body">
            <h3>{entry.data.name}</h3>
            <div class="loc-body"><Content /></div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section>
    <h2>Heard Of</h2>
    <div class="grid cols-3" style="margin-top:20px">
      {mentioned.map(({ entry, Content }) => (
        <article class="panel">
          <h3 style="margin:0 0 6px">{entry.data.name}</h3>
          <div class="loc-body"><Content /></div>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .loc-body :global(p) { margin: 8px 0 0; font-size: 0.96rem; }
</style>
