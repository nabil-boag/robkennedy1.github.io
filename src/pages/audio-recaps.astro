---
import Layout from '../layouts/Layout.astro';


// Audio recaps: theatrical retellings of each session, narrated by Atlas.
// Final MP3s live in public/audio/session-NN-recap.mp3 and are listed in
// public/podcast.xml. Until an episode's MP3 exists its card renders in a
// "coming soon" state with the player disabled — never point <audio> src at
// a file that doesn't exist.
// Base-aware links: import.meta.env.BASE_URL is '/' in production and
// '/robkennedy1.github.io/' on the fork's project-Pages staging preview.
const base = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? base : base + href.slice(1));

const episodes = [  {
    n: 1,
    slug: 'session-01',
    title: 'Prisoners of the Drow',
    date: '26 July 2025',
    blurb: 'Five strangers wake as slaves in a drow outpost, lose two of their fellow prisoners, and strike a desperate bargain to escape.',
    audio: '/audio/session-01-recap.mp3',
    duration: '7:27',
  },
  {
    n: 2,
    slug: 'session-02',
    title: 'A Daring Escape',
    date: '31 July 2025',
    blurb: 'The break for freedom — down through the webs, past the thing in the pool, and out into the dark while demons tear the outpost apart.',
    audio: '/audio/session-02-recap.mp3',
    duration: '8:42',
  },
  {
    n: 3,
    slug: 'session-03',
    title: 'The Deep Father',
    date: '22 August 2025',
    blurb: 'Seven days of tunnels, a favour owed to goblins, a friend lost to a spectator — and a god pulled out of the lake by a father\'s knife.',
    audio: '/audio/session-03-recap.mp3',
    duration: '8:53',
  },
  {
    n: 4,
    slug: 'session-04',
    title: 'The Shores of Darklake',
    date: '18 September 2026',
    blurb: 'Going back into a town with a demon lord still in it, a bandit ambush that finally puts clothes on their backs, and three of the party discovering they can do things they could not do before.',
    audio: '/audio/session-04-recap.mp3',
    duration: '7:06',
  },
];
---
<style>
  .recap-player {
    width: 100%;
    margin-top: 12px;
    display: block;
  }
  .recap-player:disabled {
    opacity: 0.55;
  }
  .coming-soon {
    display: inline-block;
    margin-top: 12px;
    padding: 3px 10px;
    border: 1px solid var(--accent-2);
    border-radius: 999px;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--accent-2);
  }
  .episode-duration {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .subscribe-card {
    margin-top: 32px;
  }
</style>
<Layout title="Audio Recaps" description="Theatrical audio recaps of every Out of the Abyss session, narrated by Atlas.">
  <p class="eyebrow">Podcast</p>
  <h1 class="page-title">Audio Recaps</h1>
  <p class="lead">
    Every session retold as a short theatrical audio episode. Listen here, or subscribe via the <a href={withBase('/podcast.xml')}>RSS feed</a> so they land in your podcast app as soon as they're released.
  </p>

  <div class="grid cols-2" style="margin-top:32px">
    {episodes.map((ep) => (
      <article class="card">
        <div class="body">
          <p class="meta">Session {ep.n} · {ep.date} · <span class="episode-duration">{ep.duration}</span></p>
          <h3>{ep.title}</h3>
          <p>{ep.blurb}</p>
          {ep.audio ? (
            <audio class="recap-player" controls preload="metadata" src={withBase(ep.audio)}>
              Your browser does not support the audio element.
            </audio>
          ) : (
            <>
              <span class="coming-soon">Episode in production</span>
              <audio class="recap-player" controls preload="none" disabled>
                Your browser does not support the audio element.
              </audio>
            </>
          )}
          <p class="meta" style="margin-top:8px">
            <a href={withBase(`/sessions/${ep.slug}`)}>Read the full session notes →</a>
          </p>
        </div>
      </article>
    ))}
  </div>

  <section class="card subscribe-card">
    <div class="body">
      <h3>Subscribe to the podcast</h3>
      <p>
        Paste <a href={withBase('/podcast.xml')}>https://robkennedy1.github.io/podcast.xml</a> into your podcast app's
        “Add podcast by URL / RSS” option and new recaps will arrive automatically.
      </p>
    </div>
  </section>

  <p class="meta" style="margin-top:32px">
    Music: “Oppressive Gloom”, “Dark Times” and “Lord of the Land” by Kevin MacLeod
    (incompetech.com), licensed under Creative Commons Attribution 4.0.
  </p>
</Layout>
