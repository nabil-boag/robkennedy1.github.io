---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const sessions = (await getCollection('sessions')).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Layout title="Sessions">
  <p class="eyebrow">Game Log</p>
  <h1 class="page-title">Sessions</h1>
  <p class="lead">Every game so far, in the order it was played. Click a session to read the full account.</p>

  <div class="grid cols-2" style="margin-top:32px">
    {sessions.map((s) => (
      <article class="card">
        <a href={`/sessions/${s.slug}`}>
          {s.data.heroImage && <img class="thumb" src={s.data.heroImage} alt={s.data.title} loading="lazy" />}
          <div class="body">
            <p class="meta">Session {s.data.sessionNumber} · {fmt(s.data.date)}{s.data.chapter ? ` · ${s.data.chapter}` : ''}</p>
            <h3>{s.data.title}</h3>
            <p>{s.data.blurb}</p>
          </div>
        </a>
      </article>
    ))}
  </div>
</Layout>
