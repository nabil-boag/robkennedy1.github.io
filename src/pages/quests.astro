---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const all = (await getCollection('quests')).sort((a, b) => a.data.order - b.data.order);

// Pre-render bodies (render() is async, so resolve before templating).
const rendered = await Promise.all(
  all.map(async (entry) => ({ entry, Content: (await entry.render()).Content }))
);
const quests = rendered.filter((r) => r.entry.data.kind === 'quest');
const lore = rendered.filter((r) => r.entry.data.kind === 'lore');

const statusLabel: Record<string, string> = {
  active: 'Active', completed: 'Completed', failed: 'Failed', unknown: 'Unknown',
};
---
<Layout title="Quests & Lore">
  <p class="eyebrow">The Threads</p>
  <h1 class="page-title">Quests &amp; Lore</h1>
  <p class="lead">Goals the party is chasing, and the mysteries and knowledge they have gathered along the way.</p>

  <section>
    <h2>Quests</h2>
    <div class="grid cols-2" style="margin-top:20px">
      {quests.map(({ entry, Content }) => (
        <article class="panel">
          <p style="margin:0 0 6px"><span class={`badge ${entry.data.status}`}>{statusLabel[entry.data.status]}</span></p>
          <h3 style="margin:0 0 6px">{entry.data.title}</h3>
          <div class="quest-body"><Content /></div>
        </article>
      ))}
    </div>
  </section>

  <section>
    <h2>Lore &amp; Mysteries</h2>
    <div class="grid cols-2" style="margin-top:20px">
      {lore.map(({ entry, Content }) => (
        <article class="panel">
          <p style="margin:0 0 6px"><span class="badge lore">Lore</span></p>
          <h3 style="margin:0 0 6px">{entry.data.title}</h3>
          <div class="quest-body"><Content /></div>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .quest-body :global(p) { margin: 8px 0 0; font-size: 0.98rem; }
</style>
